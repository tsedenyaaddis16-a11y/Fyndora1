# AI Student Mentor Configuration
# Leave OPENAI_API_KEY empty to use the built-in intelligent offline mentor engine,
# or set your OpenAI API key (or compatible service e.g. OpenRouter, DeepSeek) for live LLM responses.
AI_PROVIDER=openai
AI_MODEL=gpt-4o-mini
OPENAI_API_KEY=your_openai_api_key_here
