PORT=5000
DB_TYPE=mysql
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=root
DB_NAME=pathfinder
JWT_SECRET=pathfinder_super_secret_jwt_key_2026_change_in_production
